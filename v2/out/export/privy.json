{
  "vendor": "privy",
  "method": "eth_signTransaction",
  "fill": [
    "privy_wallet_id"
  ],
  "steps": [
    {
      "step": "create the rolling 1-hour USDT window",
      "returns": "aggregation_usdt",
      "request": {
        "method": "POST",
        "url": "https://api.privy.io/v1/aggregations",
        "auth": "Basic <app id>:<app secret>, plus the privy-app-id header",
        "body": {
          "name": "rein usdt window",
          "method": "eth_signTransaction",
          "metric": {
            "field_source": "ethereum_calldata",
            "field": "transfer.value",
            "abi": [
              {
                "type": "function",
                "name": "transfer",
                "stateMutability": "nonpayable",
                "inputs": [
                  {
                    "name": "to",
                    "type": "address"
                  },
                  {
                    "name": "value",
                    "type": "uint256"
                  }
                ],
                "outputs": [
                  {
                    "name": "",
                    "type": "bool"
                  }
                ]
              },
              {
                "type": "function",
                "name": "approve",
                "stateMutability": "nonpayable",
                "inputs": [
                  {
                    "name": "spender",
                    "type": "address"
                  },
                  {
                    "name": "value",
                    "type": "uint256"
                  }
                ],
                "outputs": [
                  {
                    "name": "",
                    "type": "bool"
                  }
                ]
              }
            ],
            "function": "sum"
          },
          "window": {
            "type": "rolling",
            "seconds": 3600
          },
          "conditions": [
            {
              "field_source": "ethereum_transaction",
              "field": "to",
              "operator": "eq",
              "value": "0xdAC17F958D2ee523a2206206994597C13D831ec7"
            }
          ]
        }
      }
    },
    {
      "step": "create the policy: 2 allow rule(s), nothing else allowed",
      "returns": "policy",
      "request": {
        "method": "POST",
        "url": "https://api.privy.io/v1/policies",
        "auth": "Basic <app id>:<app secret>, plus the privy-app-id header",
        "body": {
          "version": "1.0",
          "name": "Rein compiled policy",
          "chain_type": "ethereum",
          "rules": [
            {
              "name": "USDT to known payees, per tx and per window",
              "method": "eth_signTransaction",
              "action": "ALLOW",
              "conditions": [
                {
                  "field_source": "ethereum_transaction",
                  "field": "chain_id",
                  "operator": "eq",
                  "value": "8453"
                },
                {
                  "field_source": "ethereum_transaction",
                  "field": "to",
                  "operator": "eq",
                  "value": "0xdAC17F958D2ee523a2206206994597C13D831ec7"
                },
                {
                  "field_source": "ethereum_calldata",
                  "field": "transfer.to",
                  "abi": [
                    {
                      "type": "function",
                      "name": "transfer",
                      "stateMutability": "nonpayable",
                      "inputs": [
                        {
                          "name": "to",
                          "type": "address"
                        },
                        {
                          "name": "value",
                          "type": "uint256"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "",
                          "type": "bool"
                        }
                      ]
                    },
                    {
                      "type": "function",
                      "name": "approve",
                      "stateMutability": "nonpayable",
                      "inputs": [
                        {
                          "name": "spender",
                          "type": "address"
                        },
                        {
                          "name": "value",
                          "type": "uint256"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "",
                          "type": "bool"
                        }
                      ]
                    }
                  ],
                  "operator": "in",
                  "value": [
                    "<Payroll>",
                    "<Router>",
                    "<Supplier A>",
                    "<Supplier B>",
                    "<Supplier C>"
                  ]
                },
                {
                  "field_source": "ethereum_calldata",
                  "field": "transfer.value",
                  "abi": [
                    {
                      "type": "function",
                      "name": "transfer",
                      "stateMutability": "nonpayable",
                      "inputs": [
                        {
                          "name": "to",
                          "type": "address"
                        },
                        {
                          "name": "value",
                          "type": "uint256"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "",
                          "type": "bool"
                        }
                      ]
                    },
                    {
                      "type": "function",
                      "name": "approve",
                      "stateMutability": "nonpayable",
                      "inputs": [
                        {
                          "name": "spender",
                          "type": "address"
                        },
                        {
                          "name": "value",
                          "type": "uint256"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "",
                          "type": "bool"
                        }
                      ]
                    }
                  ],
                  "operator": "lte",
                  "value": "0xdf847580"
                },
                {
                  "field_source": "reference",
                  "field": "aggregation.{{aggregation_usdt.id}}",
                  "operator": "lte",
                  "value": "0xee89ac80"
                }
              ]
            },
            {
              "name": "USDT approvals, capped",
              "method": "eth_signTransaction",
              "action": "ALLOW",
              "conditions": [
                {
                  "field_source": "ethereum_transaction",
                  "field": "chain_id",
                  "operator": "eq",
                  "value": "8453"
                },
                {
                  "field_source": "ethereum_transaction",
                  "field": "to",
                  "operator": "eq",
                  "value": "0xdAC17F958D2ee523a2206206994597C13D831ec7"
                },
                {
                  "field_source": "ethereum_calldata",
                  "field": "approve.spender",
                  "abi": [
                    {
                      "type": "function",
                      "name": "transfer",
                      "stateMutability": "nonpayable",
                      "inputs": [
                        {
                          "name": "to",
                          "type": "address"
                        },
                        {
                          "name": "value",
                          "type": "uint256"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "",
                          "type": "bool"
                        }
                      ]
                    },
                    {
                      "type": "function",
                      "name": "approve",
                      "stateMutability": "nonpayable",
                      "inputs": [
                        {
                          "name": "spender",
                          "type": "address"
                        },
                        {
                          "name": "value",
                          "type": "uint256"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "",
                          "type": "bool"
                        }
                      ]
                    }
                  ],
                  "operator": "in",
                  "value": [
                    "<Payroll>",
                    "<Router>",
                    "<Supplier A>",
                    "<Supplier B>",
                    "<Supplier C>"
                  ]
                },
                {
                  "field_source": "ethereum_calldata",
                  "field": "approve.value",
                  "abi": [
                    {
                      "type": "function",
                      "name": "transfer",
                      "stateMutability": "nonpayable",
                      "inputs": [
                        {
                          "name": "to",
                          "type": "address"
                        },
                        {
                          "name": "value",
                          "type": "uint256"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "",
                          "type": "bool"
                        }
                      ]
                    },
                    {
                      "type": "function",
                      "name": "approve",
                      "stateMutability": "nonpayable",
                      "inputs": [
                        {
                          "name": "spender",
                          "type": "address"
                        },
                        {
                          "name": "value",
                          "type": "uint256"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "",
                          "type": "bool"
                        }
                      ]
                    }
                  ],
                  "operator": "lte",
                  "value": "0x1dcd6500"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "step": "attach it to the agent's wallet (a wallet holds one policy, so this replaces any other)",
      "request": {
        "method": "PATCH",
        "url": "https://api.privy.io/v1/wallets/{{privy_wallet_id}}",
        "auth": "Basic <app id>:<app secret>, plus the privy-app-id header; a wallet with an owner also needs privy-authorization-signature",
        "body": {
          "policy_ids": [
            "{{policy.id}}"
          ]
        }
      }
    }
  ],
  "leftOut": [
    {
      "contract": "Router",
      "address": "<Router>",
      "functions": [
        "swapExact"
      ],
      "why": "Privy can only limit which function is called with the contract's ABI, so Rein leaves it out rather than allow every function on it. Add an ABI rule by hand, or have a person approve these calls."
    }
  ]
}
