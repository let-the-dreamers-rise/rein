{
  "name": "rein-wallet",
  "version": "0.1.1",
  "description": "Scan an AI agent's wallet for the spending policy its own history supports, put that policy on Privy, Turnkey or Coinbase CDP, and watch for anything outside it. Plus a smart account an agent can operate and cannot drain.",
  "mcpName": "io.github.let-the-dreamers-rise/rein",
  "keywords": [
    "ai-agent",
    "agent-wallet",
    "wallet-policy",
    "mcp",
    "mcp-server",
    "privy",
    "turnkey",
    "coinbase-cdp",
    "smart-account",
    "base",
    "ethereum",
    "security"
  ],
  "homepage": "https://github.com/let-the-dreamers-rise/rein#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/let-the-dreamers-rise/rein.git"
  },
  "bugs": {
    "url": "https://github.com/let-the-dreamers-rise/rein/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "rein-wallet": "bin/rein.js",
    "rein": "bin/rein.js",
    "rein-mcp": "mcp/rein-mcp.js",
    "rein-scan": "scan/cli.js"
  },
  "files": [
    "index.js",
    "bin/",
    "scan/*.js",
    "scan/README.md",
    "scan/watch-action.yml",
    "scan/safe-action.yml",
    "mcp/rein-mcp.js",
    "mcp/lib/",
    "mcp/sandbox/",
    "api/server.js",
    "scripts/codes.js",
    "v2/export.js",
    "QUICKSTART.md"
  ],
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "build:sandbox": "hardhat compile && node scripts/build-sandbox.js",
    "build:bundle": "node scripts/build-bundle.js",
    "v2": "hardhat run scripts/v2/demo.js",
    "v2:export": "node v2/export.js",
    "mcp": "node mcp/rein-mcp.js",
    "sandbox": "node mcp/rein-mcp.js --sandbox",
    "api": "node api/server.js",
    "api:sandbox": "node api/server.js --sandbox",
    "scan": "node scan/cli.js",
    "watch": "node bin/rein.js watch",
    "v2:compare": "python v2/compare.py v2/out/trail.jsonl",
    "v2:robust": "python v2/compile.py v2/out/trail.jsonl --robust --out v2/out/robust",
    "test:compiler": "python -m unittest discover -s v2 -p \"test_*.py\"",
    "preflight": "hardhat run scripts/preflight.js --network whitechainSepolia",
    "deploy:whitechain": "hardhat run scripts/deploy.js --network whitechainSepolia",
    "demo:whitechain": "hardhat run scripts/demo-injection.js --network whitechainSepolia",
    "verify:whitechain": "hardhat verify --network whitechainSepolia",
    "preflight:base": "hardhat run scripts/preflight.js --network baseSepolia",
    "deploy:base": "hardhat run scripts/deploy.js --network baseSepolia",
    "demo:base": "hardhat run scripts/demo-injection.js --network baseSepolia",
    "verify:base": "hardhat verify --network baseSepolia",
    "preflight:sepolia": "hardhat run scripts/preflight.js --network sepolia",
    "bridge:base": "hardhat run scripts/bridge-to-base.js --network sepolia",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "demo:sepolia": "hardhat run scripts/demo-injection.js --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia",
    "preflight:goat": "hardhat run scripts/preflight.js --network goatTestnet",
    "deploy:goat": "hardhat run scripts/deploy.js --network goatTestnet",
    "demo:goat": "hardhat run scripts/goat-pay-and-rate.js --network goatTestnet",
    "verify:goat": "hardhat verify --network goatTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "esbuild": "^0.28.2",
    "hardhat": "^2.22.17"
  },
  "dependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0"
  },
  "main": "index.js"
}
